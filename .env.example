# ==============================================================================
# ClimaNexo (Weather Dashboard Pro) — Configuración de Variables de Entorno
# ==============================================================================
# Copiá este archivo como `.env` si deseás personalizar puertos o agregar claves
# opcionales. El sistema funciona de inmediato sin configurar claves API gracias
# a sus 6 proveedores meteorológicos abiertos preintegrados.

# Servidor HTTP (FastAPI / Uvicorn)
HOST=127.0.0.1
PORT=8050

# Ruta de la base de datos SQLite (modo WAL, se inicializa automáticamente)
DATABASE_PATH=data/weather_dashboard.db

# Intervalos automáticos administrados por el servidor Python (en segundos)
AUTO_REFRESH_SECONDS=600
COLLECTOR_INTERVAL_SECONDS=300
SNAPSHOT_TTL_SECONDS=600
COMPARISON_TTL_SECONDS=600

# Proveedores adicionales opcionales (dejar vacíos si no se utilizan)
WEATHERAPI_KEY=
OPENWEATHER_API_KEY=
